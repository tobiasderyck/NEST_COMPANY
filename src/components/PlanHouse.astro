---
const tiles=Array.from({length:12},(_,index)=>index);
---
<svg class="plan-house" viewBox="0 0 480 310" fill="none" aria-hidden="true">
 <defs>
  <linearGradient id="nest-ground" x1="42" y1="211" x2="430" y2="279" gradientUnits="userSpaceOnUse"><stop stop-color="#edf0e7"/><stop offset="1" stop-color="#dce4d8"/></linearGradient>
  <linearGradient id="nest-wall-front" x1="117" y1="126" x2="292" y2="287" gradientUnits="userSpaceOnUse"><stop stop-color="#fffaf0"/><stop offset="1" stop-color="#e6e9dd"/></linearGradient>
  <linearGradient id="nest-wall-side" x1="260" y1="184" x2="385" y2="218" gradientUnits="userSpaceOnUse"><stop stop-color="#e0e6dc"/><stop offset="1" stop-color="#cbd8ce"/></linearGradient>
  <linearGradient id="nest-roof" x1="121" y1="133" x2="273" y2="179" gradientUnits="userSpaceOnUse"><stop stop-color="#d4decf"/><stop offset="1" stop-color="#a9b9a7"/></linearGradient>
  <linearGradient id="nest-skyglass" x1="187" y1="156" x2="272" y2="244" gradientUnits="userSpaceOnUse"><stop stop-color="#d7e7df"/><stop offset="1" stop-color="#a5bec1"/></linearGradient>
  <filter id="nest-floor-shadow" x="0" y="0" width="480" height="310" filterUnits="userSpaceOnUse"><feGaussianBlur stdDeviation="11"/></filter>
 </defs>
