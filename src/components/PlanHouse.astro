 <g class="house-siding" stroke="#9eaea2" opacity=".42"><path d="m98 165 138 51M98 185l138 51M244 215l138-51M244 236l138-51"/></g>
 <path class="house-roof-left" d="M82 129 237 52 241 193 82 137Z" fill="url(#nest-roof)" stroke="#40564f" stroke-width="2"/>
