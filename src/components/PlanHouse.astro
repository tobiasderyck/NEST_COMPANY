  {tiles.map(index=><g class="panel-tile" data-panel-index={index} transform={`translate(${(index%4)*23} ${Math.floor(index/4)*18})`}><rect width="20" height="15" rx="1" fill="#324f55" stroke="#d9e6e0" stroke-width="1.4"/><path d="M2 7.5H18M10 1.5V13.5" stroke="#74949a" stroke-width=".8" opacity=".9"/></g>)}
 </g>
