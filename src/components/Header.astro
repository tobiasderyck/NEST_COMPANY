---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { groups, services, url, contact } from '../data/nest';
---
<a class="skip-link" href="#main">Naar de inhoud</a>
<header class="header" id="header">
 <div class="header-inner"><Logo/>
  <nav class="desktop-nav" aria-label="Hoofdnavigatie">
   <button class="nav-toggle" aria-expanded="false" aria-controls="solutions-menu" data-menu-toggle="solutions-menu">Oplossingen <Icon name="plus" size={14}/></button>
   <a href="/realisaties/">Realisaties</a><a href="/nestverkenner/">NEST-verkenner</a><a href="/over-ons/over-nest-company/">Over NEST</a><a href="/contact/">Contact</a>
  </nav>
  <div class="header-actions"><a class="plan-link" href="/contact/#jouw-plan"><Icon name="house" size={19}/><span class="sr-only">Jouw plan: </span><span data-plan-count>0</span><span class="sr-only"> diensten</span></a><a class="button button-small header-advice" href="/contact/">Gratis advies <Icon name="diagonal" size={16}/></a><button class="mobile-toggle" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle="mobile-menu"><Icon name="menu"/></button></div>
 </div>
 <div class="mega-menu" id="solutions-menu" hidden><div class="mega-intro"><p>Een goed plan<br/>begint bij jou.</p><a class="text-link" href="/contact/">We denken graag mee <Icon name="arrow" size={19}/></a></div><div class="mega-groups">{groups.map(g=><div><a class="mega-title" href={g.url}>{g.name}<Icon name="diagonal" size={17}/></a>{services.filter(s=>s.group===g.id && !['gevel','totaal'].includes(g.id)).map(s=><a href={url(s.slug)}>{s.title}</a>)}</div>)}</div></div>
 <nav class="mobile-menu" id="mobile-menu" aria-label="Mobiele navigatie" hidden><div class="mobile-menu-top">Wat wil je aanpakken?</div>{groups.map(g=><details><summary>{g.name}<Icon name="plus" size={20}/></summary><div><a href={g.url}>Bekijk {g.name.toLowerCase()}</a>{services.filter(s=>s.group===g.id&&!['gevel','totaal'].includes(g.id)).map(s=><a href={url(s.slug)}>{s.title}</a>)}</div></details>)}<a href="/realisaties/">Realisaties</a><a href="/over-ons/ons-team/">De mensen van NEST</a><a href="/waarom-nest-company/">Onze begeleiding</a><a href="/nestverkenner/">NEST-verkenner</a><a href="/blog/">Vragen & inzichten</a><a href="/contact/">Contact</a><a class="mobile-call" href={'tel:'+contact.tel}>{contact.phone}<Icon name="phone" size={20}/></a></nav>
</header>
<div class="menu-scrim" data-menu-close hidden></div>
