---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {title='Van huis. Naar nest.',description='Dakwerken, gevel- en totaalrenovatie en slimme energieoplossingen. NEST Company denkt mee van persoonlijk advies tot uitvoering en opvolging.',hideCta=false,surface='home'}=Astro.props;
const canoniek = new URL(Astro.url.pathname, Astro.site).href;
const geenIndex = Astro.url.pathname.startsWith('/404');
// korte samenvattingen aanvullen tot een volwaardige zoekbeschrijving
const beschrijving = description.length < 100 ? `${description} NEST Company uit Machelen begeleidt je van advies tot opvolging.` : description;
const bedrijf = {
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', '@id': 'https://nestcompany.be/#bedrijf',
  name: 'NEST Company BV', url: 'https://nestcompany.be/', email: 'info@nestcompany.be', telephone: '+32492864202',
  vatID: 'BE1013321485', logo: 'https://nestcompany.be/favicon.svg', image: 'https://nestcompany.be/assets/web/og-nest.jpg',
  address: { '@type': 'PostalAddress', streetAddress: 'De Kleetlaan 5/BC', postalCode: '1831', addressLocality: 'Machelen', addressCountry: 'BE' },
  areaServed: 'Vlaams-Brabant',
  knowsAbout: ['Dakwerken', 'Dakisolatie', 'Gevelrenovatie', 'Zonnepanelen', 'Thuisbatterijen', 'Warmtepompboilers', 'Airco', 'Laadpalen', 'Off-grid energiesystemen']
};
---
<!doctype html><html lang="nl-BE"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#efeeea"/><title>{title} · NEST Company</title><meta name="description" content={beschrijving}/><link rel="canonical" href={canoniek}/><meta property="og:type" content="website"/><meta property="og:locale" content="nl_BE"/><meta property="og:site_name" content="NEST Company"/><meta property="og:url" content={canoniek}/><meta name="twitter:card" content="summary_large_image"/>{geenIndex&&<meta name="robots" content="noindex"/>}<script type="application/ld+json" set:html={JSON.stringify(bedrijf)}/><meta property="og:title" content={`${title} · NEST Company`}/><meta property="og:description" content={beschrijving}/><meta property="og:image" content={new URL("/assets/web/og-nest.jpg", Astro.site).href}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="stylesheet" href="/fonts/archivo.css"/><link rel="stylesheet" href="/fonts/general-sans.css"/><link rel="preload" href="/fonts/archivo-breed-100_900-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="stylesheet" href="/nest.css"/><link rel="stylesheet" href="/atmosphere.css"/><link rel="stylesheet" href="/leven.css"/><slot name="head"/></head><body><Header/><main id="main" data-surface={surface}><slot/></main><Footer hideCta={hideCta}/><script is:inline src="/nest.js" defer></script></body></html>
