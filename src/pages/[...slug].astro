---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { services, editorial, groups, team, asset, srcset, url, serviceById, contact } from '../data/nest';
export function getStaticPaths() {
 const indexPages=[
  {slug:'energieoplossingen',kind:'overview',title:'Energieoplossingen',headline:'Meer doen met je eigen energie.',summary:'Van één installatie tot een energiesysteem waarin alles samenwerkt. We beginnen bij jouw woning en je verbruik.',image:'leuven',group:'energie'},
  {slug:'dakwerken',kind:'overview',title:'Dakwerken',headline:'Alles begint met een goed dak.',summary:'Beschermen, isoleren, vernieuwen. NEST bekijkt wat jouw dak nodig heeft en denkt mee over de volgende stap.',image:'dak-lucht',group:'dak'},
  {slug:'waarom-nest-company',kind:'guidanceIndex',title:'Onze begeleiding',headline:'Een goed gevoel. Van begin tot verder.',summary:'Je hoeft niet alle antwoorden al te kennen. Daar zijn wij voor.',image:'werf'},
  {slug:'realisaties',kind:'projects',title:'Realisaties',headline:'Van een goed plan naar een fijne plek.',summary:'Een blik op het werk en de keuzes achter onze oplossingen.',image:'werf'},
  {slug:'blog',kind:'insights',title:'Vragen & inzichten',headline:'Een heldere kijk op je volgende stap.',summary:'Zonnepanelen, een batterij, een nieuw dak? Begin met de vragen die ertoe doen.',image:'zolder'},
  {slug:'contact',kind:'contact',title:'Contact',headline:'Vertel eens. Wat zijn je plannen?',summary:'Een eerste idee of een concreet project: we bekijken graag wat bij je past.',image:'k5_nest'}
 ];
 return [...services.map(p=>({...p,kind:'service'})),...editorial,...indexPages].map(page=>({params:{slug:page.slug},props:{page}}));
}
const {page}=Astro.props as {page:any};
const isService=page.kind==='service';
const parent=isService?(page.group==='energie'?{title:'Energieoplossingen',href:'/energieoplossingen/'}:page.group==='dak'?{title:'Dakwerken',href:'/dakwerken/'}:null):null;
const related=(page.related||[]).map(serviceById).filter(Boolean);
const guidance=editorial.filter(p=>p.kind==='guidance');
const concept=page.image?.startsWith('k');
const cases=editorial.filter(p=>p.kind==='case');
---
<SiteLayout title={page.title} description={page.summary} hideCta={page.kind==='contact'||Boolean(page.question)} surface={page.group || page.kind}>
 <div class="wrap"><nav class="breadcrumbs" aria-label="Kruimelpad"><a href="/">Home</a><Icon name="chevron" size={12}/>{parent&&<><a href={parent.href}>{parent.title}</a><Icon name="chevron" size={12}/></>}<span aria-current="page">{page.title}</span></nav></div>
 {page.kind==='contact'?<section class="contact-page wrap"><div class="contact-intro"><h1>Vertel eens.<br/>Wat zijn je <em>plannen?</em></h1><p>{page.summary}</p><div class="contact-direct"><a href={'tel:'+contact.tel}><Icon name="phone"/>{contact.phone}</a><a href={'mailto:'+contact.email}><Icon name="mail"/>{contact.email}</a></div><div class="contact-locations"><div><h3>Machelen</h3><p>De Kleetlaan 5<br/>1831 Machelen</p></div><div><h3>Lebbeke</h3><p>Opwijksestraat 91<br/>9280 Lebbeke</p></div></div><div class="contact-doodle" aria-hidden="true"><svg viewBox="0 0 400 180"><path d="M25 153h350M90 153V75l88-59 88 59v78M178 16v137M105 91h45v40h-45M204 89h35v64M90 75l88 26 88-26M286 153v-30q25-45 45 0v30"/></svg><span>Een goed gesprek is het begin.</span></div></div><div class="contact-form-shell" id="jouw-plan"><div class="plan-paper"><span class="paper-tab">Jouw nest begint hier</span><h2>Leg je plannen<br/>maar op <em>tafel.</em></h2><div data-plan-summary><p class="plan-empty">Je hoeft nog niet precies te weten wat je nodig hebt.</p></div><form id="contact-form"><label for="name">Hoe mogen we je noemen?</label><input id="name" name="name" autocomplete="name" placeholder="Je naam" required maxlength="100"/><label for="email">Op welk e-mailadres kunnen we je bereiken?</label><input id="email" name="email" type="email" autocomplete="email" placeholder="jij@voorbeeld.be" required maxlength="180"/><label for="message">Wat wil je graag bespreken?</label><textarea id="message" name="message" rows="4" placeholder="Vertel kort over je woning, je idee of je vraag." required maxlength="5000"></textarea><p class="form-explainer">Deze knop zet je aanvraag klaar in je eigen e-mailprogramma. Je leest ze na en verstuurt ze zelf naar NEST.</p><button class="button" type="submit">Maak mijn adviesaanvraag klaar <Icon name="diagonal" size={19}/></button><p class="form-status" role="status" aria-live="polite" data-form-status></p><button class="text-link copy-request" type="button" data-copy-request hidden>Kopieer mijn aanvraag <Icon name="plus" size={16}/></button><noscript><p>Mail je plannen rechtstreeks naar <a href={'mailto:'+contact.email}>{contact.email}</a> of bel {contact.phone}.</p></noscript></form></div></div></section>:<>
 <section class="page-hero wrap"><div><h1>{page.headline}</h1><p>{page.summary}</p><div class="page-hero-actions"><a class="button" href={'/contact/?onderwerp='+encodeURIComponent(page.title)}>Plan je gratis adviesgesprek <Icon name="diagonal" size={18}/></a>{isService&&<button class="text-link" data-plan-add={page.title} aria-pressed="false"><span>Bewaar in mijn plan</span><Icon name="plus" size={18}/></button>}</div></div><figure class="page-hero-image"><img src={asset(page.image)} srcset={srcset(page.image)} sizes="(max-width: 860px) 100vw, 50vw" alt={page.imageAlt || (concept?'Conceptbeeld ter illustratie van de oplossing':'Projectbeeld uit het NEST-archief')} width="1000" height="1000" fetchpriority="high"/>{concept&&<figcaption>Verbeelding van de mogelijkheden</figcaption>}<span class="image-fold" aria-hidden="true"></span></figure></section>
 {isService&&<><section class="service-intro wrap section-pad"><h2>Een oplossing die<br/>bij <em>jou</em> past.</h2><div><p class="lead-copy">{page.intro}</p><ul class="benefit-list">{page.benefits.map((b:string)=><li><Icon name="check" size={19}/>{b}</li>)}</ul></div></section><section class="detail-content wrap">{page.sections.map((s:any,i:number)=><article class="detail-section"><span class="detail-symbol" aria-hidden="true"><Icon name={i===0?'house':'sun'} size={34}/></span><div><h2>{s.title}</h2><p>{s.text}</p>{s.items&&<ul>{s.items.map((item:string)=><li>{item}</li>)}</ul>}</div></article>)}</section>{page.brands.length>0&&<section class="brands-section wrap section-pad"><div><h2>Het juiste merk<br/>volgt uit het <em>plan.</em></h2><p>We werken met verschillende merken. Zo blijft jouw situatie het vertrekpunt.</p></div><div class="brand-list">{page.brands.map((b:string)=><span>{b}</span>)}</div></section>}<section class="service-advice wrap"><p>Ook advies, configuratie en opvolging<br/>horen bij een goed resultaat.</p><a class="text-link" href="/waarom-nest-company/">Zo begeleiden we je <Icon name="arrow" size={20}/></a></section>{related.length>0&&<section class="related-section wrap section-pad"><div class="section-heading"><h2>Past goed<br/><em>samen.</em></h2><p>Eén ingreep of een groter plan.<br/>We bekijken de verbinding.</p></div><div class="related-list">{related.map((s:any)=><a href={url(s.slug)}><img src={asset(s.image)} srcset={srcset(s.image)} sizes="(max-width: 860px) 100vw, 50vw" alt="" loading="lazy" width="400" height="300"/><div><h3>{s.title}</h3><p>{s.summary}</p></div><Icon name="diagonal" size={23}/></a>)}</div></section>}</>}
 {page.kind==='overview'&&<section class="wrap section-pad"><div class="section-heading"><h2>Wat past bij<br/>jouw <em>plannen?</em></h2><p>Verken de mogelijkheden.<br/>Of laat ons met je meedenken.</p></div><div class="overview-services">{services.filter(s=>s.group===page.group).map(s=><article><a href={url(s.slug)} class="overview-link"><img src={asset(s.image)} srcset={srcset(s.image)} sizes="(max-width: 860px) 100vw, 50vw" alt={s.imageAlt} loading="lazy" width="560" height="430"/><div><h3>{s.title}</h3><p>{s.summary}</p><span class="text-link">Ontdek de mogelijkheden <Icon name="diagonal" size={18}/></span></div></a><button class="save-service" data-plan-add={s.title} aria-label={s.title+' toevoegen aan mijn plan'} aria-pressed="false"><Icon name="plus" size={20}/></button></article>)}</div></section>}
 {['guidance','story','team','case'].includes(page.kind)&&<section class="editorial-body wrap section-pad"><aside><span class="reading-mark"></span><p>{page.kind==='case'?'De keuzes achter het project.':page.kind==='team'?'Vakkennis met een gezicht.':'Duidelijke keuzes. Persoonlijke begeleiding.'}</p><a class="text-link" href="/contact/">Stel je vraag <Icon name="arrow" size={18}/></a></aside><div>{page.sections.map((s:any)=><article class="editorial-chapter"><h2>{s.title}</h2><p>{s.text}</p>{s.items&&<ul>{s.items.map((item:string)=><li>{item}</li>)}</ul>}</article>)}{page.kind==='team'&&<div class="team-list"><h2>En de mensen<br/>die het mee <em>waarmaken.</em></h2>{team.map(([name,role])=><div><span>{name}</span><span>{role}</span></div>)}</div>}{page.kind==='story'&&<a class="button button-outline" href="/over-ons/ons-team/">Maak kennis met ons team <Icon name="diagonal" size={18}/></a>}</div></section>}
 {page.kind==='guidanceIndex'&&<section class="wrap section-pad"><div class="guidance-index">{guidance.map((g,i)=><a href={url(g.slug)}><span class="guidance-context">{['Voor je kiest','Als alles samenkomt','Rond je project','En daarna'][i]}</span><h2>{g.headline}</h2><p>{g.summary}</p><span class="text-link">{g.title}<Icon name="diagonal" size={20}/></span></a>)}</div></section>}
 {page.kind==='projects'&&<><section class="project-gallery wrap section-pad"><figure><img src={asset('leuven')} srcset={srcset('leuven')} sizes="(max-width: 860px) 100vw, 50vw" alt="Dakwerk en zonnepanelen bij een woning in Leuven" width="1000" height="700" loading="lazy"/><figcaption>Dakwerk & zonnepanelen — Leuven</figcaption></figure><figure><img src={asset('zolder')} srcset={srcset('zolder')} sizes="(max-width: 860px) 100vw, 50vw" alt="Geïsoleerde zolder met houten dakstructuur" width="700" height="1000" loading="lazy"/><figcaption>Comfort begint onder het dak.</figcaption></figure><figure><img src={asset('werf')} srcset={srcset('werf')} sizes="(max-width: 860px) 100vw, 50vw" alt="Woning met bijgebouw en zonnepanelen" width="1000" height="700" loading="lazy"/><figcaption>Renovatie en energie in één geheel.</figcaption></figure></section><section class="wrap section-pad"><div class="section-heading"><h2>De gedachte<br/>achter het <em>werk.</em></h2><p>Elke woning is anders.<br/>Deze verhalen laten zien hoe we kijken.</p></div><div class="case-links">{cases.map(c=><a href={url(c.slug)}><h3>{c.title}</h3><p>{c.summary}</p><span class="text-link">Lees het projectverhaal <Icon name="diagonal" size={20}/></span></a>)}</div></section></>}
 {page.kind==='insights'&&<section class="insights-body wrap section-pad"><div class="question-list">{[
 ['Is een thuisbatterij altijd interessant?','Dat hangt af van je verbruik, zonnepanelen en toekomstplannen. Een goede analyse komt vóór de keuze voor een batterij.','energieoplossingen/thuisbatterijen','Lees over thuisbatterijen'],
 ['Mijn dak is aan vernieuwing toe. Wat pak ik samen aan?','Een dakrenovatie is een logisch moment om isolatie en mogelijke zonnepanelen te bespreken. Zo passen de keuzes bij elkaar.','dakwerken/dakrenovatie','Lees over dakrenovatie'],
 ['Wat doet een EMS eigenlijk?','Een energiemanagementsysteem stemt je installaties op elkaar af. Het gaat over wanneer je energie gebruikt, opslaat of naar een andere verbruiker stuurt.','energieoplossingen/ems-systemen','Ontdek slim energiebeheer'],
 ['Kan ik klein beginnen en later uitbreiden?','Je hoeft niet alles tegelijk te doen. Vertel ons je plannen voor later, zodat we bij de eerste stap al rekening kunnen houden met uitbreiding.','waarom-nest-company/persoonlijk-advies','Zo begint ons advies'],
 ['Helpen jullie ook met de administratie?','NEST begeleidt je bij relevante documenten, aanvragen en registraties. Welke stappen nodig zijn, bekijken we voor jouw project.','waarom-nest-company/premies-en-aanvragen','Bekijk de begeleiding'],
 ['Airco of een warmtepompboiler: wat is het verschil?','Een lucht-luchtwarmtepomp verwarmt en koelt ruimtes. Een warmtepompboiler maakt sanitair warm water. De toepassing bepaalt de keuze.','energieoplossingen/airco-en-warmtepompboilers','Vergelijk de toepassingen']
 ].map(([q,a,path,label],i)=><details open={i===0}><summary>{q}<Icon name="plus" size={22}/></summary><div><p>{a}</p><a class="text-link" href={url(path)}>{label}<Icon name="diagonal" size={18}/></a></div></details>)}</div><aside class="insight-note"><Icon name="house" size={38}/><h2>Jouw situatie<br/>blijft het <em>vertrekpunt.</em></h2><p>Een artikel kan je op weg helpen. Een gesprek maakt het persoonlijk.</p><a class="text-link" href="/contact/">Bespreek jouw vraag <Icon name="arrow" size={18}/></a></aside></section>}
 {page.question&&<section class="page-question wrap"><h2>{page.question}</h2><p>{page.cta}</p><a class="button" href={'/contact/?onderwerp='+encodeURIComponent(page.title)}>Plan je gratis adviesgesprek <Icon name="diagonal" size={20}/></a></section>}
 </>}
</SiteLayout>
