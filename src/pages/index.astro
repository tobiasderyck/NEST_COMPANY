---
import home from '../../content/homepage.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import {services,groups,asset,url} from '../data/nest';
---
<SiteLayout>
 <section class="home-hero wrap">
  <div class="hero-film" data-film>
   <img class="film-poster" src={asset('k1_oud')} alt="Een oud Belgisch huis dat in de film wordt vernieuwd tot een comfortabel nest" width="1700" height="949" fetchpriority="high"/>
   <video class="film-video" data-film-a muted playsinline preload="none" aria-hidden="true" disablepictureinpicture></video><video class="film-video" data-film-b muted playsinline preload="none" aria-hidden="true" disablepictureinpicture></video>
   <div class="film-shutter" aria-hidden="true"><span>Welkom thuis.</span></div>
   <div class="hero-wash" aria-hidden="true"></div>
   <div class="hero-intro"><h1>{home.titleStart}<br/><span>{home.titleEnd} <em>{home.titleAccent}</em><svg class="nest-underline" viewBox="0 0 260 20" aria-hidden="true"><path d="M3 14C66 1 174 0 254 9M21 19c78-7 151-6 209-4"/></svg></span></h1><div class="hero-description"><p>{home.promise}<br/>{home.description}</p><a class="button" href="/contact/">{home.adviceButton} <Icon name="diagonal" size={20}/></a><a class="text-link" href="#oplossingen">{home.servicesLink} <Icon name="arrow" size={18}/></a></div></div>
   <div class="film-caption"><span class="live-dot"></span><span data-film-stage>Een huis vol mogelijkheden</span></div>
   <button class="film-control" data-film-control aria-label="Renovatiefilm afspelen"><Icon name="play" size={18}/><span data-film-control-label>Afspelen</span></button>
   <div class="film-timeline" aria-label="De renovatie in vier delen"><span data-film-chapter="0" class="is-current">Dak</span><span data-film-chapter="1">Energie</span><span data-film-chapter="2">Gevel</span><span data-film-chapter="3">Thuis</span></div>
  </div>
  <div class="hero-footnote"><span>Jouw woning. Jouw ritme. Eén aanspreekpunt.</span><span>Een verbeelding van wat mogelijk is.</span></div>
 </section>
 <section class="intro-statement wrap section-pad"><p>Een dak dat beschermt.<br/>Energie die samenwerkt.<br/><span>Een huis waarin alles klopt.</span></p><div><span class="small-roof" aria-hidden="true"></span><p>{home.intro}</p><a class="text-link" href="/over-ons/over-nest-company/">Daarom NEST <Icon name="diagonal" size={18}/></a></div></section>
 <section class="services-section section-pad" id="oplossingen"><div class="wrap"><div class="section-heading"><h2>{home.servicesTitle}<br/><em>{home.servicesAccent}</em></h2><p>{home.servicesDescription}</p></div>
 <div class="service-editorial"><div class="service-picture"><img src={asset('dak-lucht')} alt="Een blik op het dak van een woning" loading="lazy" width="900" height="900" data-service-image/><div class="picture-note" data-service-note-output>De basis van een goed nest.</div><div class="picture-edge" aria-hidden="true"></div></div><div class="service-index">{groups.map((g,i)=><div class:list={['service-group',{'is-active':i===0}]} data-service-preview={asset(g.image)} data-service-note={g.line}><div class="service-group-heading"><a href={g.url}><span>{g.name}</span><Icon name="diagonal" size={28}/></a></div><div class="service-sublinks">{services.filter(s=>s.group===g.id).map(s=><div class="service-choice"><a href={url(s.slug)}>{s.title}</a><button data-plan-add={s.title} aria-label={`${s.title} toevoegen aan jouw plan`} aria-pressed="false"><Icon name="plus" size={17}/></button></div>)}</div></div>)}</div></div>
 <div class="selection-hint"><Icon name="plus" size={17}/><p>Verschillende plannen? Verzamel ze met het plusje. We bekijken ze samen.</p><a href="/contact/#jouw-plan">Naar jouw plan <Icon name="arrow" size={17}/></a></div></div></section>
 <section class="energy-section section-pad" data-energy><div class="wrap"><div class="section-heading"><h2>De zon gaat onder.<br/>Je huis denkt <em>mee.</em></h2><p>Zonnepanelen, opslag en slimme sturing.<br/>Ontdek waarom de verbinding telt.</p></div>
 <div class="energy-experience"><div class="energy-scene" data-energy-scene><img src={asset('k3_zon')} alt="Een huis met zonnepanelen overdag" loading="lazy" width="1700" height="949"/><img class="energy-evening" src={asset('k5_nest')} alt="" loading="lazy" width="1700" height="949"/>
 <svg class="energy-paths" viewBox="0 0 1000 560" fill="none" aria-hidden="true"><path d="M520 185V280Q520 300 540 300H825V413"/><path d="M825 413H395Q375 413 375 393V340"/><circle cx="520" cy="185" r="8"/><rect x="811" y="391" width="28" height="43" rx="4"/><path d="M820 385h10M825 399l-6 13h11l-6 13"/><circle cx="375" cy="340" r="8"/></svg>
 <span class="energy-pin pin-solar">Zonnepanelen</span><span class="energy-pin pin-storage">Batterij</span><span class="energy-pin pin-home">Woning</span><span class="scene-caption">Een eenvoudige voorstelling van de samenhang</span>
 </div><div class="energy-console"><div class="sun-clock" aria-hidden="true"><svg viewBox="0 0 300 130"><path d="M25 113A125 100 0 0 1 275 113"/><path class="sun-horizon" d="M15 114h270"/><g data-sun><circle r="13"/><path d="M0-23v-5M0 23v5M23 0h5M-23 0h-5M16-16l4-4M-16 16l-4 4M-16-16l-4-4M16 16l4 4"/></g></svg></div>
 <div class="energy-time"><span data-energy-period>Overdag</span><span data-energy-time>12:00</span></div><label class="sr-only" for="energy-time">Verschuif het moment van de dag</label><input id="energy-time" type="range" min="0" max="100" value="15" aria-valuetext="Overdag: je zonnepanelen produceren energie"/><div class="range-labels"><span>Dag</span><span>Avond</span></div><div class="energy-story" aria-live="polite" aria-atomic="true"><h3 data-energy-title>De zon werkt voor je.</h3><p data-energy-copy>Je zonnepanelen produceren stroom. Je gebruikt die in huis en kunt een deel bewaren in een geschikte batterij.</p></div><a class="text-link" data-energy-link href="/energieoplossingen/zonnepanelen/">Ontdek zonnepanelen <Icon name="diagonal" size={17}/></a><div class="energy-toggle"><button data-energy-preset="15" class="is-selected" aria-pressed="true"><Icon name="sun" size={18}/>Overdag</button><button data-energy-preset="85" aria-pressed="false"><Icon name="moon" size={18}/>’s Avonds</button></div></div></div>
 <div class="energy-bottom"><p>Wat slim is voor jouw woning,<br/>begint bij jouw verbruik.</p><a class="text-link calculator-entry" href="/nestverkenner/"><span class="entry-sun" aria-hidden="true"><Icon name="sun" size={24}/></span><span>Wat betekent dat voor jouw huis?<small>Verken je combinatie en de cijfers erachter.</small></span><Icon name="arrow" size={20}/></a></div></div></section>
 <section class="projects-section wrap section-pad"><div class="section-heading"><h2>Plannen worden<br/><em>plekken.</em></h2><a class="text-link" href="/realisaties/">Bekijk onze realisaties <Icon name="diagonal" size={20}/></a></div><div class="project-spread"><a class="project-feature" href="/realisaties/"><div class="project-photo"><img src={asset('werf')} alt="Gerenoveerde woning met bijgebouw en zonnepanelen, uit het NEST-projectarchief" loading="lazy" width="1200" height="800"/><span class="round-arrow"><Icon name="diagonal" size={24}/></span></div><div class="project-title"><h3>Een huis dat verder kan.</h3><span>Renovatie & energie</span></div></a><a class="project-secondary" href="/realisaties/"><div class="project-photo"><img src={asset('leuven')} alt="Dak met zonnepanelen bij een woning in Leuven" loading="lazy" width="800" height="1000"/><span class="round-arrow"><Icon name="diagonal" size={24}/></span></div><div class="project-title"><h3>Een dak met een dubbel doel.</h3><span>Dakwerken & zonnepanelen</span></div></a></div></section>
 <section class="people-section section-pad"><div class="wrap people-layout"><div class="people-title"><h2>Twee expertises.<br/>Dezelfde <em>goesting.</em></h2><p>Tommy kent het dak. Joeri kent de energie.<br/>Samen kijken ze verder dan één installatie.</p><a class="text-link" href="/over-ons/ons-team/">Ontmoet de mensen achter NEST <Icon name="diagonal" size={20}/></a></div><div class="people-folder" data-tilt><div class="folder-back"></div><div class="founder-sheet sheet-tommy"><span class="sheet-word">dak.</span><div><h3>Tommy</h3><p>Opgegroeid in een dakwerkersfamilie.<br/>Vakmanschap van binnenuit.</p></div><span class="sheet-role">Tommy Van der Haegen</span></div><div class="founder-sheet sheet-joeri"><span class="sheet-word">energie.</span><div><h3>Joeri</h3><p>Zonnepanelen, batterijen en sturing.<br/>Altijd het geheel in beeld.</p></div><span class="sheet-role">Joeri Vranckx</span></div><div class="folder-stamp">Eén team.<br/>Jouw aanspreekpunt.</div></div></div></section>
 <section class="guidance-section wrap section-pad"><div class="section-heading"><h2>Ook wat je niet ziet,<br/>moet <em>kloppen.</em></h2><p>Van het eerste idee tot de opvolging.<br/>We blijven betrokken.</p></div><div class="guidance-lines"><a href="/waarom-nest-company/persoonlijk-advies/"><span>Voor je kiest</span><h3>Eerlijk, merkonafhankelijk advies.</h3><Icon name="diagonal"/></a><a href="/waarom-nest-company/configuratie-optimalisatie/"><span>Als alles samenkomt</span><h3>Een installatie die goed is afgestemd.</h3><Icon name="diagonal"/></a><a href="/waarom-nest-company/premies-en-aanvragen/"><span>Rond je project</span><h3>Ook de administratie op orde.</h3><Icon name="diagonal"/></a><a href="/waarom-nest-company/administratieve-opvolging/"><span>En daarna</span><h3>Een aanspreekpunt dat blijft.</h3><Icon name="diagonal"/></a></div></section>
</SiteLayout>
