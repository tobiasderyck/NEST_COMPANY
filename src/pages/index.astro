---
/* Homepage in drie schermen.
   A · Het huis is het menu: klik op een deel van het huis, de film speelt die verbouwing.
   B · Klanten noemen ons bij naam: de ploeg, met de Google-reviews die hen vermelden.
   C · De plooimeter: drie vragen, de duimstok klapt per antwoord een lid verder open.
   Teksten: content/homepage.json en content/reviews.json (beheerd via Tina). */
import home from '../../content/homepage.json';
import reviews from '../../content/reviews.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import OffGrid from '../components/OffGrid.astro';
import { contact } from '../data/nest';

const { hero, delen, ploeg, meter } = home;
/* plaats van elk huisdeel in het filmbeeld (procent van het 16:9-beeld) */
const punten = [{ x: 21, y: 25 }, { x: 44, y: 22 }, { x: 63, y: 50 }, { x: 60, y: 75 }];
const [voor, na] = hero.regel2.split(hero.nadruk);
const vakken = [
 { naam: 'Dakwerken', wat: 'Pannen, isolatie, zinkwerk en herstellingen', link: '/dakwerken/', foto: 'gerenoveerd-dak' },
 { naam: 'Zonnepanelen', wat: 'Installatie, omvormers en thuisbatterijen', link: '/energieoplossingen/zonnepanelen/', foto: 'pannendak-zonnepanelen' },
 { naam: 'Gevelrenovatie', wat: 'Crepi, gevelbekleding en buitenschrijnwerk', link: '/gevelrenovatie/', foto: 'werf' },
 { naam: 'Warmtepompen en airco', wat: 'Verwarmen én koelen, fluisterstil', link: '/energieoplossingen/airco-en-warmtepompboilers/', foto: 'airco-zolder' },
 { naam: 'Totale renovatie', wat: 'Van het eerste plan tot de sleutel op de deur', link: '/totaalrenovatie/', foto: 'dakrenovatie-werf' }
];
const d0 = delen[0];

/* wie wordt hoe vaak bij naam genoemd */
const tel = (naam: string) => reviews.items.filter(r => r.over.split(',').map(s => s.trim()).includes(naam)).length;
const metReviews = new Set(['Tommy', 'Joeri', 'Danny', 'Glenn']);
const eersteSet = reviews.items.filter(r => r.over.includes('Joeri'));
const opties = {
  wat: ['Dak', 'Zonnepanelen', 'Thuisbatterij', 'Gevel', 'Airco of boiler', 'Laadpaal', 'Alles in één keer'],
  woning: ['Rijwoning', 'Halfopen', 'Open bebouwing', 'Bedrijfspand'],
  wanneer: ['Zo snel mogelijk', 'Dit jaar nog', 'Ik verken nog']
};
---
<SiteLayout hideCta surface="home" title="Dak, zonnepanelen, batterij en gevel in Vlaams-Brabant" description="Eén Vlaamse ploeg uit Machelen voor je dak, zonnepanelen, thuisbatterij en gevel. Gratis adviesbezoek met uitleg en cijfers. 5,0 op Google uit 20 reviews.">
 <link slot="head" rel="stylesheet" href="/home.css"/>
 <script slot="head" is:inline>matchMedia("(min-width: 861px)").matches && document.documentElement.classList.add("kop-over");</script>
 <link slot="head" rel="preload" as="image" href="/assets/web/k1_oud-800.webp" imagesrcset="/assets/web/k1_oud-800.webp 800w, /assets/web/k1_oud-1280.webp 1280w, /assets/web/k1_oud.webp 1700w" imagesizes="(max-width: 860px) 100vw, 1440px" fetchpriority="high"/>

 <!-- A · HET HUIS IS HET MENU -->
 <section class="nh-hero" aria-labelledby="nh-titel">
  <div class="nh-buhne" data-buhne>
   <div class="nh-podium">
    <img class="nh-poster" data-poster src="/assets/web/k1_oud-1280.webp" srcset="/assets/web/k1_oud-800.webp 800w, /assets/web/k1_oud-1280.webp 1280w, /assets/web/k1_oud.webp 1700w" sizes="(max-width: 860px) 100vw, 1440px" alt="Een Vlaamse woning die deel per deel vernieuwd wordt: dak, zonnepanelen, gevel en een buitenunit" width="1700" height="949" fetchpriority="high"/>
    <video class="nh-film" data-nh-film muted playsinline preload="none" disablepictureinpicture aria-hidden="true"></video>
    <div class="nh-punten" role="tablist" aria-label="Kies een deel van het huis">
     {delen.map((d, i) => (
      <button class="nh-punt" role="tab" id={`nh-tab-${i}`} aria-controls="nh-paneel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-deel={i} style={`--x:${punten[i].x}%;--y:${punten[i].y}%`}>
       <span class="nh-stip" aria-hidden="true"></span><span class="nh-lijn" aria-hidden="true"></span>
       <span class="nh-label"><span class="nh-nr">0{i + 1}</span>{d.naam}</span>
      </button>
     ))}
    </div>
   </div>
   <div class="nh-scrim" aria-hidden="true"></div>

   <div class="nh-belofte">
    <h1 id="nh-titel">{hero.regel1}<br/>{voor}<em>{hero.nadruk}</em>{na}</h1>
    <p>{hero.tekst}</p>
    <div class="nh-acties">
     <a class="button" href="/contact/">{hero.knop} <Icon name="diagonal" size={18}/></a>
     <a class="nh-tel" href={'tel:' + contact.tel}>{contact.phone}</a>
    </div>
   </div>

   <nav class="nh-rail" aria-label="Bekijk een onderdeel van het huis">
    {delen.map((d, i) => <button type="button" data-deel={i} aria-controls="nh-paneel" class:list={[{ 'is-actief': i === 0 }]}><i aria-hidden="true"></i><span>{d.naam}</span></button>)}
    <button type="button" class="nh-rail-alle" data-alle-diensten><i aria-hidden="true"></i><span>Alle diensten</span><Icon name="plus" size={14}/></button>
   </nav>
   <p class="nh-tabs-hint">Tik op een onderdeel van het huis</p>
   <div class="nh-tabs-gsm" aria-hidden="true">{delen.map((d, i) => <button tabindex="-1" data-deel={i} class:list={[{ 'is-actief': i === 0 }]}>{d.naam}</button>)}</div>
   <aside class="nh-paneel" id="nh-paneel" role="tabpanel" aria-labelledby="nh-tab-0" aria-live="polite">
    <div class="nh-paneel-kop"><span data-p-nr>01</span><span>van 04</span></div>
    <h2 data-p-titel>{d0.titel}</h2>
    <p data-p-tekst>{d0.tekst}</p>
    <ul data-p-punten>{d0.punten.map(p => <li>{p}</li>)}</ul>
    <figure class="nh-echt">
     <img data-p-foto src={d0.foto.replace('.webp', '-240.webp')} alt={d0.fotoTekst} width="240" height="160" loading="lazy"/>
     <figcaption><span>Werk van de ploeg</span><span data-p-fototekst>{d0.fotoTekst}</span></figcaption>
    </figure>
    <div class="nh-paneel-acties">
     <a class="button button-small" data-p-knop href={`/contact/?onderwerp=${encodeURIComponent(d0.titel)}`}>{d0.knop} <Icon name="diagonal" size={16}/></a>
     <a class="text-link" data-p-link href={d0.link}>Lees meer <Icon name="arrow" size={16}/></a>
    </div>
    <div class="nh-voortgang" aria-hidden="true"><span data-p-balk></span></div>
   </aside>

   <button class="nh-pauze" data-pauze aria-label="Film pauzeren" hidden><span></span><span></span></button>
  </div>
 </section>


 <!-- VIJF VAKGEBIEDEN. EÉN DAK. -->
 <section class="nh-diensten" aria-labelledby="vak-titel">
  <h2 id="vak-titel">Vijf vakgebieden. <em>Eén dak.</em></h2>
  <ul class="nh-diensten-lijst">
   {vakken.map(v => (
    <li><a href={v.link}>
     <span class="nh-diensten-naam">{v.naam}</span>
     <span class="nh-diensten-wat">{v.wat}</span>
     <span class="nh-diensten-pijl" aria-hidden="true"><Icon name="arrow" size={22}/></span>
     <img class="nh-diensten-foto" src={`/assets/web/${v.foto}-800.webp`} alt="" width="800" height="560" loading="lazy" decoding="async"/>
    </a></li>
   ))}
  </ul>
  <p class="nh-diensten-ook">Ook voor bedrijfspanden en kmo's: <a href="/energieoplossingen/industriele-batterijen/">industriële oplossingen</a>.</p>
 </section>

 <!-- OFF-GRID -->
 <OffGrid thuis/>

 <!-- B · KLANTEN NOEMEN ONS BIJ NAAM -->
 <section class="nh-ploeg" id="ploeg" aria-labelledby="ploeg-titel">
  <div class="nh-ploeg-kop">
   <h2 id="ploeg-titel">{ploeg.titel}</h2>
   <p>{ploeg.tekst}</p>
  </div>
  <div class="nh-ploeg-raster">
   <figure class="nh-groep">
    <div class="nh-fotovak" role="img" aria-label={ploeg.fotoNoot}>
     <span class="nh-hoek nh-hoek--lb"></span><span class="nh-hoek nh-hoek--rb"></span><span class="nh-hoek nh-hoek--lo"></span><span class="nh-hoek nh-hoek--ro"></span>
     <span class="nh-fotonoot">{ploeg.fotoNoot}</span>
    </div>
    <figcaption>
     <span class="nh-vlnr">V.l.n.r.</span>{' '}
     {ploeg.mensen.map((m, i) => (
      <span class="nh-mens">{metReviews.has(m.naam)
        ? <button class="nh-naam" data-wie={m.naam} aria-pressed={m.naam === 'Joeri' ? 'true' : 'false'}>{m.naam}<sup>{tel(m.naam)}</sup></button>
        : <span class="nh-naam-stil">{m.naam}</span>}{' '}<span class="nh-vak">({m.vak}){i < ploeg.mensen.length - 1 ? ',' : '.'}</span>{' '}</span>
     ))}
     <button class="nh-naam nh-naam--rest" data-wie="ploeg" aria-pressed="false">Wat anderen schrijven<sup>{reviews.items.filter(r => !r.over).length}</sup></button>
    </figcaption>
   </figure>

   <div class="nh-stemmen">
    <div class="nh-stem-lijst" data-stemmen aria-live="polite">
     {eersteSet.map((r, i) => (
      <blockquote class:list={['nh-stem', { 'nh-stem--groot': i === 0 }]}>
       <p set:html={r.tekst.replace(/\b(Joeri|Jouri|Joerie)\b/g, '<mark>$1</mark>')}/>
       <footer><span aria-label={`${r.sterren} op 5 sterren`}>{'★'.repeat(r.sterren)}</span>{r.klant}</footer>
      </blockquote>
     ))}
    </div>
    <div class="nh-google">
     <svg class="nh-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.5z"/></svg>
     <span><strong>{reviews.gemiddelde}</strong> op Google, uit {reviews.aantal} reviews.</span>
     <a class="text-link" href={ploeg.googleLink} target="_blank" rel="noopener">Lees ze op Google <Icon name="diagonal" size={15}/></a>
    </div>
   </div>
  </div>
 </section>

 <!-- C · ZET DE KOFFIE MAAR KLAAR: stel je woning samen -->
 <section class="nk" id="opmeten" aria-labelledby="nk-titel">
  <div class="nk-kop">
   <h2 id="nk-titel">Zet de koffie maar <em>klaar.</em></h2>
   <p>{meter.tekst}</p>
  </div>
  <div class="nk-raster">
   <form class="nk-vragen" data-nk-vorm action="/contact/" method="get">
    <fieldset>
     <legend>Wat wil je aanpakken?</legend>
     <div class="nk-opties">
      {['Dak', 'Zonnepanelen', 'Gevel', 'Warmtepomp of airco', 'Laadpaal'].map(o => <label class="nk-optie"><input type="checkbox" name="wat" value={o}/><span>{o}</span></label>)}
     </div>
     <div class="nk-opties nk-opties--klein">
      <span>Ook:</span>
      {['Thuisbatterij'].map(o => <label class="nk-optie"><input type="checkbox" name="wat" value={o}/><span>{o.toLowerCase()}</span></label>)}
     </div>
    </fieldset>
    <fieldset>
     <legend>Wat voor woning is het?</legend>
     <div class="nk-opties">
      {[['open', 'Open bebouwing'], ['halfopen', 'Halfopen'], ['rij', 'Rijwoning'], ['appartement', 'Appartement']].map(([v, t], i) => <label class="nk-optie"><input type="radio" name="woning" value={v} data-tekst={t} checked={i === 0}/><span>{t}</span></label>)}
     </div>
    </fieldset>
    <fieldset>
     <legend>Wanneer wil je starten?</legend>
     <div class="nk-opties">
      {['Zo snel mogelijk', 'Binnen het halfjaar', 'Ik kijk nog rond'].map(o => <label class="nk-optie"><input type="radio" name="wanneer" value={o}/><span>{o}</span></label>)}
     </div>
    </fieldset>
   </form>

   <div class="nk-toon">
    <figure class="nk-kader" data-nk>
     <div class="nk-kantel" data-nk-kantel>
     <img class="nk-beeld" data-nk-a src="/assets/huis/open-000.webp" alt="" width="1280" height="880" loading="lazy" decoding="async"/>
     <img class="nk-beeld nk-b" data-nk-b alt="" width="1280" height="880" aria-hidden="true"/>
     <img class="nk-beeld nk-laag nk-wp" data-nk-wp alt="" width="1280" height="880" aria-hidden="true"/>
     <img class="nk-beeld nk-laag nk-steiger" data-nk-steiger alt="" width="1280" height="880" aria-hidden="true"/>
     <img class="nk-beeld nk-laag" data-nk-laadpaal alt="" width="1280" height="880" aria-hidden="true"/>
     <img class="nk-beeld nk-laag nk-rijst" data-nk-bord alt="" width="1280" height="880" aria-hidden="true"/>
     </div>
     <figcaption data-nk-bijschrift>Open bebouwing, zoals ze er nu staat</figcaption>
    </figure>
    <div class="nk-slot">
     <p class="nk-zin" data-nk-zin aria-live="polite">Kies wat je wil aanpakken. Het huis doet mee.</p>
     <div class="nk-acties">
      <a class="button" href="/contact/#jouw-plan" data-nk-knop>{meter.knop} <Icon name="diagonal" size={18}/></a>
      <a class="nh-tel nh-tel--donker" href={'tel:' + contact.tel}>of bel {contact.phone}</a>
     </div>
    </div>
   </div>
  </div>
 </section>

 <script is:inline type="application/json" id="nh-data" set:html={JSON.stringify({ delen, reviews: reviews.items })}></script>
 <script is:inline src="/home.js" defer></script>
</SiteLayout>
