---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import tekst from '../../content/verkenner.json';
import { contact } from '../data/nest';
import PlanHouse from '../components/PlanHouse.astro';
import OffGrid from '../components/OffGrid.astro';
const bronnen = [
  ['Verbruikscategorieën 1.200 / 3.500 / 7.500 kWh', 'Vlaamse Nutsregulator', 'https://www.vlaamsenutsregulator.be/elektriciteit-en-aardgas/energieprijzen-en-facturen/energieverbruik'],
  ['Opbrengst van zonnepanelen in Machelen', 'Europese Commissie, PVGIS 5.3', 'https://re.jrc.ec.europa.eu/pvg_tools/nl/'],
  ['Stroomprijs per kWh, Vlaanderen 2026', 'CREG', 'https://www.creg.be/nl/consumenten/prijzen-en-tarieven/tarief-voor-terugbetaling-thuisladen-bedrijfswagens'],
  ['Netkosten Fluvius Halle-Vilvoorde 2026', 'Vlaamse Nutsregulator', 'https://www.vlaamsenutsregulator.be/elektriciteit-en-aardgas/nettarieven/hoeveel-bedragen-de-distributienettarieven'],
  ['Vergoeding voor teruggeleverde stroom', 'Test-Aankoop, mei 2026', 'https://www.test-aankoop.be/woning-energie/hernieuwbare-energie/nieuws/kosten-geinjecteerde-zonnestroom'],
  ['Eigen verbruik met en zonder batterij', 'HTW Berlin', 'https://solar.htw-berlin.de/rechner/unabhaengigkeitsrechner/'],
  ['Praktijktest van 518 thuisbatterijen', 'Energent, 2024', 'https://energent.be/wp-content/uploads/2024/06/20240612-Rapport-praktijktest-thuisbatterijen-Final-1.pdf'],
  ['Capaciteitstarief', 'Vlaamse Nutsregulator', 'https://www.vlaamsenutsregulator.be/elektriciteit-en-aardgas/nettarieven/capaciteitstarief'],
  ['Warmtepompboiler: 3 tot 4 keer zuiniger', 'Vlaanderen.be', 'https://www.vlaanderen.be/bouwen-wonen-en-energie/groene-energie/warmtepompboiler']
];
---
<SiteLayout title="Wat kan jouw huis besparen?" description="Bereken in drie vragen wat zonnepanelen, een thuisbatterij of een warmtepompboiler jouw gezin per jaar kunnen besparen. Met cijfers uit openbare bronnen van 2026." hideCta surface="calculator">
<link slot="head" rel="stylesheet" href="/verkenner/verkenner.css"/>
<div class="wrap vk">
 <nav class="breadcrumbs" aria-label="Kruimelpad"><a href="/">Home</a><Icon name="chevron" size={12}/><span aria-current="page">NEST-verkenner</span></nav>

 <header class="vk-kop">
  <h1>Wat kan jouw huis <em>besparen?</em></h1>
  <p>{tekst.intro}</p>
 </header>

 <div class="vk-werk">
  <form class="vk-vragen" id="vk-vragen" novalidate>
   <fieldset class="vk-vraag">
    <legend><span class="vk-nr">1</span>Hoeveel stroom verbruikt je gezin?</legend>
    <div class="vk-keuzes vk-keuzes--3">
     <label><input type="radio" name="verbruik" value="laag"/><span><strong>Laag</strong><small>±1.200 kWh per jaar</small><small class="vk-wie">Alleen of met twee, appartement</small></span></label>
     <label><input type="radio" name="verbruik" value="doorsnee" checked/><span><strong>Doorsnee</strong><small>±3.500 kWh per jaar</small><small class="vk-wie">Gezin in een gewone woning</small></span></label>
     <label><input type="radio" name="verbruik" value="hoog"/><span><strong>Hoog</strong><small>±7.500 kWh per jaar</small><small class="vk-wie">Groot gezin, veel toestellen of elektrische boiler</small></span></label>
    </div>
    <p class="vk-noot">Dit zijn de verbruiksklassen van de Vlaamse Nutsregulator. 3.500 kWh is de maat die de regulator en de CREG gebruiken voor een doorsnee gezin.</p>
   </fieldset>

   <fieldset class="vk-vraag">
    <legend><span class="vk-nr">2</span>Wat wil je combineren?</legend>
    <div class="vk-keuzes vk-keuzes--rij">
     <label><input type="checkbox" name="zon" checked/><span><Icon name="sun" size={22}/><strong>Zonnepanelen</strong></span></label>
     <label><input type="checkbox" name="batterij"/><span><Icon name="battery" size={22}/><strong>Thuisbatterij</strong></span></label>
     <label><input type="checkbox" name="boiler"/><span><Icon name="house" size={22}/><strong>Warmtepompboiler</strong><small>in plaats van een elektrische boiler</small></span></label>
    </div>
    <p class="vk-ook"><span>Ook mee in je plan:</span>
     <label><input type="checkbox" name="ook" value="Dakwerken"/><span>dakwerken</span></label>
     <label><input type="checkbox" name="ook" value="Dakisolatie"/><span>dakisolatie</span></label>
     <label><input type="checkbox" name="ook" value="Laadpaal"/><span>laadpaal</span></label>
     <label><input type="checkbox" name="ook" value="Airco"/><span>airco</span></label>
     <label><input type="checkbox" name="ook" value="Slimme sturing (EMS)"/><span>slimme sturing</span></label>
     <label><input type="checkbox" name="ook" value="Gevelrenovatie"/><span>gevel</span></label>
     <label><input type="checkbox" name="ook" value="Off-grid"/><span>off-grid</span></label>
    </p>
   </fieldset>

   <fieldset class="vk-vraag" data-zonvraag>
    <legend><span class="vk-nr">3</span>Hoeveel zonnepanelen?</legend>
    <div class="vk-teller">
     <button type="button" data-min aria-label="Eén paneel minder">−</button>
     <output name="panelen" aria-live="polite"><span data-panelen>8</span> panelen</output>
     <button type="button" data-plus aria-label="Eén paneel meer">+</button>
     <p class="vk-advies" data-advies></p>
    </div>
    <p class="vk-sub">Waar ligt je dak?</p>
    <div class="vk-keuzes vk-keuzes--4 vk-klein">
     <label><input type="radio" name="dak" value="zuid"/><span><strong>Zuid</strong></span></label>
     <label><input type="radio" name="dak" value="oostwest"/><span><strong>Oost of west</strong></span></label>
     <label><input type="radio" name="dak" value="plat"/><span><strong>Plat dak</strong></span></label>
     <label><input type="radio" name="dak" value="onbekend" checked/><span><strong>Weet ik niet</strong></span></label>
    </div>
   </fieldset>
  </form>

  <aside class="vk-uitkomst" id="jouw-plan" aria-labelledby="vk-uitkomst-titel">
   <div class="vk-bon">
    <span class="vk-tab" aria-hidden="true">Jouw energieplan</span>
    <PlanHouse/>
    <p class="vk-bon-kop" id="vk-uitkomst-titel">Mogelijke besparing voor jouw huis</p>
    <p class="vk-bedrag" aria-live="polite"><span class="vk-tot">tot</span> <strong data-hoog>€ 620</strong> <span class="vk-perjaar">per jaar</span></p>
    <p class="vk-bereik" data-bereik>Meest waarschijnlijk ± € 430. Bij een ongunstig contract en een minder goed dak € 270.</p>
    <div class="vk-meter" aria-hidden="true"><span data-meter-laag></span><span data-meter-midden></span><span data-meter-hoog></span></div>
    <dl class="vk-regels" data-regels></dl>
    <p class="vk-aandeel" data-aandeel></p>
    <p class="vk-melding" data-melding hidden></p>
    <div class="vk-erbij" data-erbij hidden><p>Haal er meer uit</p><div data-erbij-knoppen></div></div>
    <p class="vk-ookplan" data-ookplan hidden></p>
    <button class="button vk-knop" type="button" data-bespreek>Bespreek dit plan met NEST <Icon name="arrow" size={19}/></button>
    <p class="vk-prijs">Wat het kost, hangt af van je dak en de materialen die we kiezen. Dat rekenen we gratis voor je uit, met een echte offerte.</p>
   </div>

   <form class="vk-aanvraag" id="vk-aanvraag" hidden novalidate data-sleutel={tekst.formulier.sleutel} data-ontvanger={tekst.formulier.ontvanger} data-onderwerp={tekst.formulier.onderwerp}>
    <h2>We bellen je terug.</h2>
    <p>Je plan gaat mee met je aanvraag. Zo weet de ploeg al wat je bekeken hebt.</p>
    <label for="vk-naam">Naam</label><input id="vk-naam" name="naam" autocomplete="name" required/>
    <label for="vk-tel">Telefoon</label><input id="vk-tel" name="telefoon" type="tel" autocomplete="tel" inputmode="tel" required/>
    <label for="vk-gemeente">Gemeente</label><input id="vk-gemeente" name="gemeente" autocomplete="address-level2" required/>
    <label for="vk-mail">E-mail <span>(niet verplicht)</span></label><input id="vk-mail" name="email" type="email" autocomplete="email"/>
    <fieldset class="vk-moment"><legend>Wanneer bellen we het best?</legend>
     <label><input type="radio" name="moment" value="Voormiddag"/><span>Voormiddag</span></label>
     <label><input type="radio" name="moment" value="Namiddag"/><span>Namiddag</span></label>
     <label><input type="radio" name="moment" value="Maakt niet uit" checked/><span>Maakt niet uit</span></label>
    </fieldset>
    <input type="checkbox" name="botcheck" class="vk-val" tabindex="-1" autocomplete="off" aria-hidden="true"/>
    <p class="vk-privacy">We gebruiken je gegevens alleen om je terug te bellen over dit plan. Meer in onze <a href="/privacy/">privacyverklaring</a>.</p>
    <button class="button" type="submit">Verstuur mijn plan <Icon name="arrow" size={19}/></button>
    <p class="vk-status" role="status" aria-live="polite" data-status></p>
   </form>

   <div class="vk-bedankt" data-bedankt hidden tabindex="-1">
    <h2>Bedankt, <span data-bedankt-naam></span>.</h2>
    <p>Je plan is bij NEST. We bellen je terug op <strong data-bedankt-tel></strong> om het samen te overlopen.</p>
    <p class="vk-noot">Liever meteen praten? Bel <a href={'tel:' + contact.tel}>{contact.phone}</a>.</p>
   </div>
  </aside>
 </div>

 <OffGrid/>

 <section class="vk-uitleg" aria-labelledby="vk-uitleg-titel">
  <h2 id="vk-uitleg-titel">Zo rekenen <em>we.</em></h2>
  <div class="vk-uitleg-kol">
   <p>We rekenen drie keer: met ongunstige, gemiddelde en gunstige waarden. Het hoge bedrag hoort bij een duur stroomcontract, een goede injectievergoeding en een zuiddak waar overdag iemand thuis is. Het lage bedrag hoort bij het omgekeerde.</p>
   <ul>
    <li><strong>Stroomprijs</strong> € 0,27 tot € 0,38 per kWh, midden € 0,32. Alleen het deel van je factuur dat daalt als je minder van het net haalt.</li>
    <li><strong>Teruglevering</strong> € 0,01 tot € 0,07 per kWh, midden € 0,04.</li>
    <li><strong>Opbrengst</strong> 849 tot 1.051 kWh per kWp per jaar, naargelang je dak. Panelen van 440 Wp.</li>
    <li><strong>Batterij</strong> 5 kWh, of 10 kWh vanaf 5.000 kWh verbruik. Inclusief een kleine winst op het capaciteitstarief.</li>
    <li><strong>Warmtepompboiler</strong> 2,5 tot 3,5 keer zuiniger dan je elektrische boiler. We nemen aan dat die boiler een derde van je stroom verbruikt.</li>
   </ul>
   <p>Geen rekening gehouden met schaduw op je dak, met toekomstige prijzen of met premies. Er is in 2026 geen premie voor zonnepanelen of een thuisbatterij. Voor een warmtepompboiler wel: tot € 450, en meer bij een lager inkomen.</p>
  </div>
  <details class="vk-bronnen"><summary>Bronnen, gecontroleerd in oktober 2026 <Icon name="plus" size={16}/></summary>
   <ul>{bronnen.map(([wat, wie, link]) => <li><a href={link} target="_blank" rel="noopener">{wat}</a><span>{wie}</span></li>)}</ul>
  </details>
 </section>
</div>
<div class="vk-balk" data-balk aria-hidden="true"><span>tot <strong data-balk-bedrag>€ 620</strong> per jaar</span><a class="button" href="#jouw-plan" tabindex="-1">Bespreek dit plan</a></div>
<script type="module" src="/verkenner/verkenner.js"></script>
</SiteLayout>
